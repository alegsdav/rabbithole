# Copy to .env.local. Everything here is server-only; nothing is exposed to the browser.

# Auth.js session encryption. Generate: openssl rand -base64 33
AUTH_SECRET=

# Google OAuth client (Web application) from Google Cloud Console.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Encrypts Google tokens at rest (AES-256-GCM). Generate: openssl rand -base64 32
TOKEN_ENC_KEY=

# Gemini, for routing searches and sorting channels into lanes (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Any Gemini model id; change it here without touching code.
GEMINI_MODEL=gemini-2.5-flash

# Optional
# DATABASE_PATH=./data/rabbithole.db
# YT_DAILY_QUOTA=10000
# YT_QUOTA_RESERVE=1500
